target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ===== 项目内 Maven 仓库 =====
# .mvn/repo 采用「本地仓库」布局（与 ~/.m2/repository 相同），体积上百 MB，
# 不提交；队友 clone 后由 mvn 自动重建，G4P 由 tools/install-g4p.cmd 装入。
# 它由 .mvn/maven.config 中的 -Dmaven.repo.local 固定。
#
# 警告：绝对不要在这里写 *.jar —— third_party/G4P/library/G4P.jar
# 是本项目唯一的 G4P 来源（G4P 不在任何 Maven 仓库上），必须入库。
.mvn/repo/

# ===== 日志 =====
*.log

# ===== 外部参考资源（体积巨大，绝不入库） =====
# ArknightsGameResource-main 是明日方舟解包资源，4.6 GB / 2.4 万个文件。
# 提交它会直接超出 GitHub 的仓库与单文件限制，push 必然失败。
# 需要时自行下载，只把**用到的那几个文件**拷进 data/ 或 resources/。
ArknightsGameResource-main/
# UI 是参考用的前端设计资料（ak-ui），跑不到 Java 工程里，也不必入库
UI/
# SpineViewer 是第三方的 .skel 预览工具（.NET 自包含程序，167 MB），
# 只是拿来核对素材用的，与工程无关
SpineViewer-*/

